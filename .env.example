# Public site origin, no trailing slash. Used for canonicals, sitemaps and Open Graph.
NEXT_PUBLIC_SITE_URL=https://serpmoz.com

# Future GrowthOS application origin (app.serpmoz.com). Leave empty until it exists;
# "Explore GrowthOS" links stay on the marketing page while this is unset.
NEXT_PUBLIC_APP_URL=

# Public contact address shown on the contact page and form fallbacks. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only. Growth Audit submissions are POSTed here as JSON (CRM, Zapier, Make, n8n, own API).
# Without it, submissions are rejected in production so leads are never silently dropped.
AUDIT_WEBHOOK_URL=
# Optional shared secret sent as the "x-serpmoz-signature" header to the webhook.
AUDIT_WEBHOOK_SECRET=

# Optional analytics (Google Tag Manager container id, e.g. GTM-XXXXXXX). Empty = no tag loaded.
NEXT_PUBLIC_GTM_ID=

# Future GrowthOS backend
# DATABASE_URL=postgresql://user:password@host:5432/serpmoz
